# Copy this file to keystore.properties (ignored by Git) for release APK signing,
# OR provide NODELIX_KEYSTORE_FILE, NODELIX_KEYSTORE_PASSWORD, NODELIX_KEY_ALIAS,
# and NODELIX_KEY_PASSWORD as environment variables in CI/local shell.
# NEVER commit real passwords or .jks/.keystore files to Git.

storeFile=/absolute/path/to/nodelix-release.jks
storePassword=CHANGE_ME
keyAlias=nodelix-release
keyPassword=CHANGE_ME
